            "showIconBackground": {
              "type": "boolean"
            },
            "enableSettingsSearch": {
              "type": "boolean"
            },
            "enableWindowsSearch": {
              "type": "boolean"
            },
            "enableSessionSearch": {
              "type": "boolean"
            },
            "ignoreMouseInput": {
              "type": "boolean"
            },
            "screenshotAnnotationTool": {
              "type": "string"
            },
            "overviewLayer": {
              "type": "boolean"
            },
            "density": {
              "type": "string",
              "enum": [
                "compact",
                "default",
                "comfortable"
              ],
              "default": "default"
            }
          }
        },
        "controlCenter": {
          "type": "object",
