{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noctalia-settings.schema.json",
  "title": "Noctalia Shell Configuration",
  "description": "Schema for noctalia.json (dump state and settings for the noctalia-shell wrapper)",
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settingsVersion": {
          "type": "integer",
          "description": "Settings schema version"
        },
        "bar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "barType": {
              "type": "string",
              "enum": [
                "simple",
                "floating",
                "framed"
              ],
              "default": "simple"
            },
            "position": {
              "type": "string",
              "enum": [
                "top",
                "bottom",
                "left",
                "right"
              ],
              "default": "top"
            },
            "monitors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "density": {
              "type": "string",
              "enum": [
                "compact",
                "default",
                "comfortable"
              ],
              "default": "default"
            },
            "showOutline": {
              "type": "boolean"
            },
            "showCapsule": {
              "type": "boolean"
            },
            "capsuleOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "capsuleColorKey": {
              "type": "string"
            },
            "widgetSpacing": {
              "type": "number"
            },
            "contentPadding": {
              "type": "number"
            },
            "fontScale": {
              "type": "number"
            },
            "enableExclusionZoneInset": {
              "type": "boolean"
            },
            "backgroundOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "useSeparateOpacity": {
              "type": "boolean"
            },
            "marginVertical": {
              "type": "number"
            },
            "marginHorizontal": {
              "type": "number"
            },
            "frameThickness": {
              "type": "number"
            },
            "frameRadius": {
              "type": "number"
            },
            "outerCorners": {
              "type": "boolean"
            },
            "hideOnOverview": {
              "type": "boolean"
            },
            "displayMode": {
              "type": "string",
              "enum": [
                "always_visible",
                "auto_hide",
                "exclusive"
              ],
              "default": "always_visible"
            },
            "autoHideDelay": {
              "type": "integer"
            },
            "autoShowDelay": {
              "type": "integer"
            },
            "showOnWorkspaceSwitch": {
              "type": "boolean"
            },
            "widgets": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "left": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/barWidget"
                  }
                },
                "center": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/barWidget"
                  }
                },
                "right": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/barWidget"
                  }
                }
              }
            },
            "mouseWheelAction": {
              "type": "string"
            },
            "reverseScroll": {
              "type": "boolean"
            },
            "mouseWheelWrap": {
              "type": "boolean"
            },
            "middleClickAction": {
              "type": "string"
            },
            "middleClickFollowMouse": {
              "type": "boolean"
            },
            "middleClickCommand": {
              "type": "string"
            },
            "rightClickAction": {
              "type": "string"
            },
            "rightClickFollowMouse": {
              "type": "boolean"
            },
            "rightClickCommand": {
              "type": "string"
            },
            "screenOverrides": {
              "type": "array",
              "items": {}
            }
          }
        },
        "general": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "avatarImage": {
              "type": "string"
            },
            "dimmerOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "showScreenCorners": {
              "type": "boolean"
            },
            "forceBlackScreenCorners": {
              "type": "boolean"
            },
            "scaleRatio": {
              "type": "number"
            },
            "radiusRatio": {
              "type": "number"
            },
            "iRadiusRatio": {
              "type": "number"
            },
            "boxRadiusRatio": {
              "type": "number"
            },
            "screenRadiusRatio": {
              "type": "number"
            },
            "animationSpeed": {
              "type": "number"
            },
            "animationDisabled": {
              "type": "boolean"
            },
            "compactLockScreen": {
              "type": "boolean"
            },
            "lockScreenAnimations": {
              "type": "boolean"
            },
            "lockOnSuspend": {
              "type": "boolean"
            },
            "showSessionButtonsOnLockScreen": {
              "type": "boolean"
            },
            "showHibernateOnLockScreen": {
              "type": "boolean"
            },
            "enableLockScreenMediaControls": {
              "type": "boolean"
            },
            "enableShadows": {
              "type": "boolean"
            },
            "enableBlurBehind": {
              "type": "boolean"
            },
            "shadowDirection": {
              "type": "string"
            },
            "shadowOffsetX": {
              "type": "number"
            },
            "shadowOffsetY": {
              "type": "number"
            },
            "language": {
              "type": "string"
            },
            "allowPanelsOnScreenWithoutBar": {
              "type": "boolean"
            },
            "showChangelogOnStartup": {
              "type": "boolean"
            },
            "telemetryEnabled": {
              "type": "boolean"
            },
            "enableLockScreenCountdown": {
              "type": "boolean"
            },
            "lockScreenCountdownDuration": {
              "type": "integer"
            },
            "autoStartAuth": {
              "type": "boolean"
            },
            "allowPasswordWithFprintd": {
              "type": "boolean"
            },
            "clockStyle": {
              "type": "string"
            },
            "clockFormat": {
              "type": "string"
            },
            "passwordChars": {
              "type": "boolean"
            },
            "lockScreenMonitors": {
              "type": "array",
              "items": {}
            },
            "lockScreenBlur": {
              "type": "number"
            },
            "lockScreenTint": {
              "type": "number"
            },
            "keybinds": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "keyUp": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keyDown": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keyLeft": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keyRight": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keyEnter": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keyEscape": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keyRemove": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "reverseScroll": {
              "type": "boolean"
            },
            "smoothScrollEnabled": {
              "type": "boolean"
            }
          }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontDefault": {
              "type": "string"
            },
            "fontFixed": {
              "type": "string"
            },
            "fontDefaultScale": {
              "type": "number"
            },
            "fontFixedScale": {
              "type": "number"
            },
            "tooltipsEnabled": {
              "type": "boolean"
            },
            "scrollbarAlwaysVisible": {
              "type": "boolean"
            },
            "boxBorderEnabled": {
              "type": "boolean"
            },
            "panelBackgroundOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "translucentWidgets": {
              "type": "boolean"
            },
            "panelsAttachedToBar": {
              "type": "boolean"
            },
            "settingsPanelMode": {
              "type": "string",
