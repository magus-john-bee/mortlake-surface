            "enableMultiMonitorDirectories": {
              "type": "boolean"
            },
            "showHiddenFiles": {
              "type": "boolean"
            },
            "viewMode": {
              "type": "string",
              "enum": [
                "single",
                "recursive",
                "browse"
              ],
              "default": "single"
            },
            "setWallpaperOnAllMonitors": {
              "type": "boolean"
            },
            "linkLightAndDarkWallpapers": {
              "type": "boolean"
            },
            "fillMode": {
              "type": "string",
              "default": "crop"
            },
            "fillColor": {
              "type": "string"
            },
            "useSolidColor": {
              "type": "boolean"
            },
            "solidColor": {
              "type": "string"
            },
            "automationEnabled": {
              "type": "boolean"
            },
            "wallpaperChangeMode": {
              "type": "string",
              "enum": [
                "random",
                "alphabetical"
              ],
              "default": "random"
            },
            "randomIntervalSec": {
              "type": "integer"
            },
            "transitionDuration": {
              "type": "integer"
            },
            "transitionType": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "fade",
                  "disc",
                  "stripes",
                  "wipe",
                  "pixelate",
                  "honeycomb"
                ]
              }
            },
            "skipStartupTransition": {
              "type": "boolean"
            },
            "transitionEdgeSmoothness": {
              "type": "number"
            },
            "panelPosition": {
              "type": "string"
            },
            "hideWallpaperFilenames": {
              "type": "boolean"
            },
            "useOriginalImages": {
              "type": "boolean"
            },
            "overviewBlur": {
              "type": "number"
            },
            "overviewTint": {
              "type": "number"
            },
            "useWallhaven": {
              "type": "boolean"
            },
            "wallhavenQuery": {
              "type": "string"
            },
            "wallhavenSorting": {
              "type": "string"
            },
            "wallhavenOrder": {
              "type": "string"
            },
            "wallhavenCategories": {
              "type": "string"
            },
            "wallhavenPurity": {
              "type": "string"
            },
            "wallhavenRatios": {
              "type": "string"
            },
            "wallhavenApiKey": {
              "type": "string"
            },
            "wallhavenResolutionMode": {
              "type": "string",
              "enum": [
                "atleast",
                "exact"
              ]
            },
            "wallhavenResolutionWidth": {
              "type": "string"
            },
            "wallhavenResolutionHeight": {
              "type": "string"
            },
            "sortOrder": {
              "type": "string",
              "enum": [
                "name",
                "name_desc",
                "date",
                "date_desc",
                "random"
              ],
              "default": "name"
            },
            "favorites": {
              "type": "array",
              "items": {}
            }
          }
        },
        "appLauncher": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enableClipboardHistory": {
              "type": "boolean"
            },
            "autoPasteClipboard": {
              "type": "boolean"
            },
            "enableClipPreview": {
              "type": "boolean"
            },
            "clipboardWrapText": {
              "type": "boolean"
            },
            "enableClipboardSmartIcons": {
              "type": "boolean"
            },
            "enableClipboardChips": {
              "type": "boolean"
            },
            "clipboardWatchTextCommand": {
