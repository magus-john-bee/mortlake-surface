            "weatherEnabled": {
              "type": "boolean"
            },
            "weatherShowEffects": {
              "type": "boolean"
            },
            "weatherTaliaMascotAlways": {
              "type": "boolean"
            },
            "useFahrenheit": {
              "type": "boolean"
            },
            "use12hourFormat": {
              "type": "boolean"
            },
            "showWeekNumberInCalendar": {
              "type": "boolean"
            },
            "showCalendarEvents": {
              "type": "boolean"
            },
            "showCalendarWeather": {
              "type": "boolean"
            },
            "analogClockInCalendar": {
              "type": "boolean"
            },
            "firstDayOfWeek": {
              "type": "integer"
            },
            "hideWeatherTimezone": {
              "type": "boolean"
            },
            "hideWeatherCityName": {
              "type": "boolean"
            },
            "autoLocate": {
              "type": "boolean"
            }
          }
        },
        "calendar": {
          "type": "object",
          "additionalProperties": false,
